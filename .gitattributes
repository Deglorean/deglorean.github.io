# Keep repository text files consistent across Windows, macOS and Linux.
# GitHub Pages serves these files exactly as committed; LF avoids needless
# line-ending-only changes when the site is edited or rebuilt.

* text=auto

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf

CNAME text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Common binary formats must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
